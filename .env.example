# Скопируй этот файл в .env.local и заполни своими значениями.
# .env.local в git не попадает — там могут быть секреты.

# true — фронт берёт тестовые данные из src/mocks, бэкенд не нужен
VITE_USE_MOCKS=true

# Адрес бэкенда. Пусто — работает прокси Vite на http://localhost:5070
# На проде: https://<имя-сервиса>.onrender.com
VITE_API_URL=

# ---------------------------------------------------------------
# Только для финальной версии (объяснения ошибок через ИИ).
# Ключ Groq живёт ТОЛЬКО на сервере, в Render → Environment.
# Никогда не добавляй его в переменные с префиксом VITE_:
# всё, что начинается с VITE_, попадает в браузер и видно пользователю.
# ---------------------------------------------------------------
GROQ_API_KEY=
